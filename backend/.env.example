# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=eventlink

# === JWT ===
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === Firebase Cloud Messaging (optionnel) ===
# Chemin vers le fichier de credentials du compte de service Firebase.
# Si absent ou invalide, les notifications sont désactivées silencieusement.
FIREBASE_CREDENTIALS_PATH=

# === CORS ===
CORS_ORIGINS=*

# === App ===
ENV=development
